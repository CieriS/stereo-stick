{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playlist Downloader",
  "version": "0.1.0",
  "identifier": "io.github.cieris.playlist-downloader",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:4340",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Playlist Downloader",
        "width": 920,
        "height": 720,
        "minWidth": 560,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
